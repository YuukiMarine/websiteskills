---
// Home page (/). Its blocks come from the top-level `sections` of the site.json.
// Sub-pages (if any) are in site.pages[] and rendered by [slug].astro.
import { site } from '../lib/site'
import Layout from '../components/Layout.astro'
import PageBody from '../components/PageBody.astro'
---

<Layout>
  <PageBody sections={site.sections} />
</Layout>
