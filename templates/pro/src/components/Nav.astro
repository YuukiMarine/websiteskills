---
import { site, LANGS } from '../lib/site'
import T from './primitives/T.astro'
import Cta from './primitives/Cta.astro'

const { brand, nav } = site
const links = nav?.links ?? []
const sticky = nav?.sticky !== false
const showLang = nav?.showLangToggle !== false && LANGS.length > 1
const langLabel: Record<string, string> = { en: 'EN', zh: '中' }
---

<header
  class:list={[
    'z-40 w-full border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-surface)_82%,transparent)] backdrop-blur-md',
    sticky && 'sticky top-0',
  ]}
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:px-6 lg:px-8">
    <!-- Brand -->
    <a href="#" class="flex shrink-0 items-center gap-2">
      {
        brand.logo.type === 'image' && brand.logo.src ? (
          <img src={brand.logo.src} alt={brand.logo.alt || brand.name} class="h-8 w-auto" />
        ) : (
          <span style="font-family:var(--font-heading)" class="text-xl font-extrabold tracking-tight text-[var(--color-ink)]">
            {brand.logo.text || brand.name}
          </span>
        )
      }
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-[var(--color-muted-ink)] transition-colors hover:text-primary"
            >
              <T text={link.label} />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right cluster -->
    <div class="flex items-center gap-2">
      {
        showLang && (
          <div class="hidden items-center rounded-full border border-[var(--color-border)] p-0.5 sm:flex">
            {LANGS.map((l) => (
              <button
                type="button"
                data-lang-switch={l}
                aria-pressed={l === site.meta.defaultLanguage ? 'true' : 'false'}
                class="rounded-full px-2.5 py-1 text-xs font-semibold text-[var(--color-muted-ink)] transition-colors aria-pressed:bg-primary aria-pressed:text-white"
              >
                {langLabel[l] || l.toUpperCase()}
              </button>
            ))}
          </div>
        )
      }
      {nav?.cta && <div class="hidden sm:block"><Cta cta={nav.cta} /></div>}

      <!-- Mobile menu button -->
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[var(--color-ink)] md:hidden"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div id="nav-drawer" class="hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="block rounded-lg px-3 py-2 text-base font-medium text-[var(--color-ink)] hover:bg-[var(--color-surface-muted)]">
              <T text={link.label} />
            </a>
          </li>
        ))
      }
      {
        nav?.cta && (
          <li class="pt-2">
            <Cta cta={nav.cta} class="w-full" />
          </li>
        )
      }
      {
        showLang && (
          <li class="flex gap-2 pt-2">
            {LANGS.map((l) => (
              <button
                type="button"
                data-lang-switch={l}
                class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs font-semibold text-[var(--color-muted-ink)] aria-pressed:bg-primary aria-pressed:text-white"
              >
                {langLabel[l] || l.toUpperCase()}
              </button>
            ))}
          </li>
        )
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle')
  const drawer = document.getElementById('nav-drawer')
  btn?.addEventListener('click', () => {
    const open = drawer?.classList.toggle('hidden') === false
    btn.setAttribute('aria-expanded', String(open))
  })
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      drawer.classList.add('hidden')
      btn?.setAttribute('aria-expanded', 'false')
    })
  )
</script>
