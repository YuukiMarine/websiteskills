---
import '../styles/global.css'
import '../styles/newchinese.css'
import '../styles/cyber.css'
import '../styles/portfolio.css'
import { site, DEFAULT_LANG } from '../lib/site'
import { themeVars } from '../lib/theme'
import { pick } from '../lib/i18n'
import Nav from './Nav.astro'
import Footer from './Footer.astro'

const themeStyle = themeVars(site.theme)
const tagline = site.brand.tagline ? pick(site.brand.tagline) : ''
const title = tagline ? `${site.meta.siteName} · ${tagline}` : site.meta.siteName
const description = pick(site.meta.description)
const themeColor = site.theme.primary ?? '#4f46e5'
---

<!doctype html>
<html lang={DEFAULT_LANG} data-lang={DEFAULT_LANG} data-template={site.theme.template} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.meta.keywords?.length ? <meta name="keywords" content={site.meta.keywords.join(', ')} /> : null}
    <link rel="canonical" href={Astro.url.href} />
    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.meta.siteName} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Mark JS-capable (enables scroll animations) + restore language, before paint -->
    <script is:inline>
      document.documentElement.classList.add('js')
      try {
        var l = localStorage.getItem('sitesmith-lang')
        if (l) document.documentElement.setAttribute('data-lang', l)
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-in animations
      if (typeof IntersectionObserver !== 'undefined') {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible')
                io.unobserve(e.target)
              }
            })
          },
          { threshold: 0.15 }
        )
        document.querySelectorAll('.animate-on-scroll').forEach((el) => io.observe(el))
      }

      // Language toggle
      const root = document.documentElement
      function setLang(l: string) {
        root.setAttribute('data-lang', l)
        try {
          localStorage.setItem('sitesmith-lang', l)
        } catch (e) {}
        document.querySelectorAll('[data-lang-switch]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-lang-switch') === l))
        })
      }
      document.querySelectorAll('[data-lang-switch]').forEach((b) => {
        b.addEventListener('click', () => setLang(b.getAttribute('data-lang-switch') || 'en'))
      })
    </script>
  </body>
</html>
