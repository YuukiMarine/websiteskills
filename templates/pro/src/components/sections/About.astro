---
import type { AboutSection } from '../../lib/site'
import Section from '../Section.astro'
import T from '../primitives/T.astro'
import Media from '../primitives/Media.astro'

interface Props {
  data: AboutSection
}
const { data } = Astro.props
const variant = data.variant ?? 'text-media'
const centered = variant === 'centered'
const mediaFirst = variant === 'media-text'
---

<Section id={data.id} background={data.background ?? 'default'}>
  {
    centered ? (
      <div class="animate-on-scroll mx-auto max-w-3xl text-center">
        {data.eyebrow && (
          <T as="p" class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary" text={data.eyebrow} />
        )}
        {data.heading && (
          <T as="h2" class="text-3xl font-bold tracking-tight md:text-4xl text-[var(--color-ink)]" text={data.heading} />
        )}
        <T as="p" class="mt-5 whitespace-pre-line text-lg leading-relaxed text-[var(--color-muted-ink)]" text={data.body} />
      </div>
    ) : (
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class:list={['animate-on-scroll', mediaFirst && 'lg:order-2']}>
          {data.eyebrow && (
            <T as="p" class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary" text={data.eyebrow} />
          )}
          {data.heading && (
            <T as="h2" class="text-3xl font-bold tracking-tight md:text-4xl text-[var(--color-ink)]" text={data.heading} />
          )}
          <T as="p" class="mt-5 whitespace-pre-line text-lg leading-relaxed text-[var(--color-muted-ink)]" text={data.body} />
        </div>
        <div class:list={['animate-on-scroll', mediaFirst && 'lg:order-1']} data-delay="1">
          <Media media={data.media} class="aspect-[4/3] w-full rounded-3xl shadow-lg ring-1 ring-[var(--color-border)]" />
        </div>
      </div>
    )
  }
</Section>
