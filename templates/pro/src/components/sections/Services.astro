---
import type { ServicesSection } from '../../lib/site'
import Section from '../Section.astro'
import SectionHeader from '../SectionHeader.astro'
import T from '../primitives/T.astro'
import Cta from '../primitives/Cta.astro'
import Media from '../primitives/Media.astro'
import Icon from '../primitives/Icon.astro'

interface Props {
  data: ServicesSection
}
const { data } = Astro.props
---

<Section id={data.id} background={data.background ?? 'default'}>
  <SectionHeader eyebrow={data.eyebrow} heading={data.heading} subheading={data.subheading} />

  <div class="mt-14 grid gap-6 sm:grid-cols-2">
    {
      data.items.map((item, i) => (
        <article
          class="ss-card animate-on-scroll group flex flex-col overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-card transition-shadow duration-200 hover:shadow-card-hover"
          data-delay={String((i % 3) + 1)}
        >
          {item.media && <Media media={item.media} class="aspect-video w-full" />}
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                {item.icon && (
                  <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius)] bg-primary-light text-primary">
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                )}
                <T as="h3" class="text-lg font-semibold text-[var(--color-ink)]" text={item.title} />
              </div>
              {item.price && (
                <T as="span" class="shrink-0 text-sm font-bold text-primary" text={item.price} />
              )}
            </div>
            <T as="p" class="mt-3 flex-1 text-[15px] leading-relaxed text-[var(--color-muted-ink)]" text={item.body} />
            {item.cta && (
              <div class="mt-4">
                <Cta cta={item.cta} />
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
