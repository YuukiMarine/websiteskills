---
import type { PricingSection } from '../../lib/site'
import Section from '../Section.astro'
import SectionHeader from '../SectionHeader.astro'
import T from '../primitives/T.astro'
import Cta from '../primitives/Cta.astro'
import Icon from '../primitives/Icon.astro'

interface Props {
  data: PricingSection
}
const { data } = Astro.props
const colClass: Record<number, string> = {
  1: 'max-w-md mx-auto',
  2: 'sm:grid-cols-2 max-w-3xl mx-auto',
  3: 'lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}
const cols = colClass[data.plans.length] ?? colClass[3]
---

<Section id={data.id} background={data.background ?? 'muted'}>
  <SectionHeader eyebrow={data.eyebrow} heading={data.heading} subheading={data.subheading} />

  <div class:list={['mt-14 grid items-start gap-6', cols]}>
    {
      data.plans.map((plan) => (
        <div
          class:list={[
            'ss-card animate-on-scroll flex flex-col rounded-[var(--radius)] border bg-[var(--color-surface)] p-6 shadow-card',
            plan.featured ? 'border-primary ring-2 ring-primary/30 lg:scale-[1.03]' : 'border-[var(--color-border)]',
          ]}
        >
          {plan.featured && (
            <span class="mb-3 inline-flex w-fit rounded-full bg-primary-light px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary">
              ★
            </span>
          )}
          <T as="h3" class="text-lg font-bold text-[var(--color-ink)]" text={plan.name} />
          <div class="mt-2 flex items-baseline gap-1">
            <T as="span" class="text-3xl font-extrabold text-[var(--color-ink)]" text={plan.price} />
            {plan.period && <T as="span" class="text-sm text-[var(--color-muted-ink)]" text={plan.period} />}
          </div>
          {plan.description && (
            <T as="p" class="mt-2 text-sm text-[var(--color-muted-ink)]" text={plan.description} />
          )}
          <ul class="mt-5 flex-1 space-y-2.5">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-[var(--color-ink)]">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                <T text={f} />
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <Cta cta={plan.cta} class="w-full" />
          </div>
        </div>
      ))
    }
  </div>
</Section>
