---
// Standard section shell: vertical rhythm + background variant + optional container.
// background classes (.bg-default/.bg-muted/.bg-dark/.bg-primary/.bg-gradient) are
// hand-defined in global.css, so the dynamic `bg-${background}` string is safe
// (not a Tailwind utility that needs static scanning).
import type { Background } from '../lib/site'

interface Props {
  id?: string
  background?: Background
  class?: string
  container?: boolean
}
const { id, background = 'default', class: className = '', container = true } = Astro.props
---

<section id={id} class:list={['section-py', `bg-${background}`, className]}>
  {
    container ? (
      <div class="mx-auto max-w-7xl px-4 md:px-6 lg:px-8">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
