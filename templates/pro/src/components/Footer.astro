---
import { site } from '../lib/site'
import T from './primitives/T.astro'
import Icon from './primitives/Icon.astro'

const { footer, brand, contact } = site

const socialIcon: Record<string, string> = {
  x: 'twitter',
  linkedin: 'linkedin',
  facebook: 'facebook',
  instagram: 'instagram',
  youtube: 'youtube',
  tiktok: 'music',
  github: 'github',
  wechat: 'message-circle',
  whatsapp: 'message-circle',
  telegram: 'send',
  email: 'mail',
}
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-muted)]">
  <div class="mx-auto max-w-7xl px-4 py-14 md:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(auto-fit,minmax(8rem,1fr))]">
      <!-- Brand column -->
      <div>
        <span style="font-family:var(--font-heading)" class="text-lg font-extrabold tracking-tight text-[var(--color-ink)]">
          {brand.logo.text || brand.name}
        </span>
        {footer?.tagline && <T as="p" class="mt-3 max-w-xs text-sm text-[var(--color-muted-ink)]" text={footer.tagline} />}
        {
          footer?.socials?.length ? (
            <ul class="mt-5 flex gap-3">
              {footer.socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    aria-label={s.platform}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-muted-ink)] transition-colors hover:border-primary hover:text-primary"
                  >
                    <Icon name={socialIcon[s.platform] || 'link'} class="h-4 w-4" label={s.platform} />
                  </a>
                </li>
              ))}
            </ul>
          ) : null
        }
      </div>

      <!-- Link columns -->
      {
        footer?.columns?.map((col) => (
          <div>
            <T as="h3" class="text-sm font-semibold text-[var(--color-ink)]" text={col.title} />
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-[var(--color-muted-ink)] transition-colors hover:text-primary">
                    <T text={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-[var(--color-border)] pt-6 text-sm text-[var(--color-muted-ink)] sm:flex-row sm:items-center">
      {
        footer?.copyright ? (
          <T text={footer.copyright} />
        ) : (
          <span>© {site.meta.siteName}</span>
        )
      }
      {contact?.email && <a href={`mailto:${contact.email}`} class="hover:text-primary">{contact.email}</a>}
    </div>
  </div>
</footer>
