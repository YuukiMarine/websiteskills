---
import '../styles/global.css'
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string
  active?: string
}
const { title = 'Console', active = 'sites' } = Astro.props
const nav = [
  { key: 'sites', label: 'Sites', href: '/', icon: 'layout-grid' },
  { key: 'new', label: 'New site', href: '/new', icon: 'plus' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Sitesmith</title>
  </head>
  <body class="min-h-dvh">
    <div class="flex min-h-dvh">
      <aside
        class="hidden w-60 shrink-0 flex-col border-r border-[var(--color-border)] bg-[var(--color-panel)] p-4 md:flex"
      >
        <div class="mb-7 flex items-center gap-2 px-2">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary font-bold text-white">S</span>
          <span class="font-semibold">Sitesmith</span>
        </div>
        <nav class="space-y-1">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                  active === n.key
                    ? 'bg-[var(--color-panel-2)] text-white'
                    : 'text-[var(--color-muted)] hover:bg-[var(--color-panel-2)] hover:text-white',
                ]}
              >
                <Icon name={`lucide:${n.icon}`} class="h-4 w-4" />
                {n.label}
              </a>
            ))
          }
        </nav>
        <form method="post" action="/api/auth" class="mt-auto">
          <input type="hidden" name="action" value="logout" />
          <button
            class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-[var(--color-muted)] transition-colors hover:bg-[var(--color-panel-2)] hover:text-white"
          >
            <Icon name="lucide:log-out" class="h-4 w-4" />
            Sign out
          </button>
        </form>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex h-14 items-center justify-between border-b border-[var(--color-border)] px-6"
        >
          <h1 class="text-sm font-semibold">{title}</h1>
          <slot name="actions" />
        </header>
        <main class="flex-1 overflow-y-auto p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
