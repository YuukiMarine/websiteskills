---
import Console from '../layouts/Console.astro'
import { isAuthed } from '../lib/auth'
import { Icon } from 'astro-icon/components'

if (!isAuthed(Astro.cookies)) return Astro.redirect('/login')

const checklist = [
  {
    icon: 'globe',
    title: 'A domain',
    body: 'Buy one from any registrar, then point its A record at your server IP.',
  },
  {
    icon: 'server',
    title: 'A server',
    body: 'Tencent Cloud HK/SG node (Ubuntu 22.04, ≥2 GB). Open ports 22 / 80 / 443.',
  },
  {
    icon: 'sparkles',
    title: 'A GLM key',
    body: 'A GLM-5.1 API key from z.ai — the AI that builds your site.',
  },
]
---

<Console title="New site" active="new">
  <form method="post" action="/api/projects" class="mx-auto max-w-2xl space-y-6">
    <section class="panel p-6">
      <div class="mb-3 flex items-center gap-2.5">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-primary text-xs font-bold text-white">1</span>
        <h2 class="font-semibold">Get the essentials</h2>
      </div>
      <p class="mb-4 text-sm text-[var(--color-muted)]">
        These you buy yourself — it's relaxed, just tick them off when ready.
      </p>
      <ul class="space-y-3">
        {
          checklist.map((c) => (
            <li class="flex items-start gap-3 rounded-lg border border-[var(--color-border)] p-3">
              <Icon name={`lucide:${c.icon}`} class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium">{c.title}</div>
                <div class="text-sm text-[var(--color-muted)]">{c.body}</div>
              </div>
              <label class="flex shrink-0 cursor-pointer items-center gap-1.5 text-xs text-[var(--color-muted)]">
                <input type="checkbox" class="accent-[var(--color-primary)]" /> Done
              </label>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel p-6">
      <div class="mb-4 flex items-center gap-2.5">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-primary text-xs font-bold text-white">2</span>
        <h2 class="font-semibold">Connect it</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Site name</span>
          <input class="field" name="name" placeholder="My bakery" required />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Domain</span>
          <input class="field" name="domain" placeholder="bakery.com" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">Server IP</span>
          <input class="field" name="serverIp" placeholder="1.2.3.4" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">SSH user</span>
          <input class="field" name="sshUser" placeholder="ubuntu" />
        </label>
        <label class="block sm:col-span-2">
          <span class="mb-1.5 block text-sm font-medium">GLM API key</span>
          <input class="field" name="glmKey" type="password" placeholder="••••••••" />
        </label>
        <label class="block sm:col-span-2">
          <span class="mb-1.5 block text-sm font-medium">SSH private key <span class="text-[var(--color-muted)]">(optional)</span></span>
          <textarea class="field" name="sshKey" rows="3" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
        </label>
      </div>
      <p class="mt-3 flex items-center gap-1.5 text-xs text-[var(--color-muted)]">
        <Icon name="lucide:lock" class="h-3.5 w-3.5" /> Keys are encrypted at rest. You can fill these in later.
      </p>
    </section>

    <div class="flex justify-end gap-2">
      <a href="/" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">
        <Icon name="lucide:arrow-right" class="h-4 w-4" /> Create &amp; build
      </button>
    </div>
  </form>
</Console>
