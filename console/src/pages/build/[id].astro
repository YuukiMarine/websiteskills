---
import Console from '../../layouts/Console.astro'
import { isAuthed } from '../../lib/auth'
import { getProject } from '../../lib/store'
import { Icon } from 'astro-icon/components'

if (!isAuthed(Astro.cookies)) return Astro.redirect('/login')
const { id } = Astro.params
const project = id ? await getProject(id) : undefined
if (!project) return Astro.redirect('/')
const hasSite = !!project.siteJson
---

<Console title={project.name} active="sites">
  <div slot="actions" class="flex gap-2">
    <button id="publishBtn" class="btn btn-primary" disabled={!hasSite}>
      <Icon name="lucide:rocket" class="h-4 w-4" /> Publish
    </button>
  </div>

  <div class="grid h-[calc(100dvh-7.5rem)] gap-4 lg:grid-cols-[380px_1fr]">
    <!-- Chat -->
    <div class="panel flex min-h-0 flex-col overflow-hidden">
      <div class="border-b border-[var(--color-border)] px-4 py-3 text-sm font-semibold">Build by chat</div>
      <div id="chat" class="flex-1 space-y-3 overflow-y-auto p-4 text-sm">
        <div class="rounded-lg bg-[var(--color-panel-2)] p-3 text-[var(--color-muted)]">
          Describe your site — business, goal, style, languages. I'll generate it, then
          you can refine by chatting more.
        </div>
      </div>
      <form id="chatForm" class="border-t border-[var(--color-border)] p-3">
        <div class="flex gap-2">
          <input id="brief" class="field" placeholder="A cozy bakery, warm style, EN + 中文…" autocomplete="off" />
          <button class="btn btn-primary px-3" type="submit"><Icon name="lucide:send" class="h-4 w-4" /></button>
        </div>
      </form>
    </div>

    <!-- Preview -->
    <div class="panel flex min-h-0 flex-col overflow-hidden">
      <div class="flex items-center justify-between border-b border-[var(--color-border)] px-4 py-3">
        <span class="text-sm font-semibold">Preview</span>
        <button id="refreshPreview" class="btn btn-ghost h-8 px-3 text-xs">
          <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" /> Render
        </button>
      </div>
      <div class="relative flex-1 bg-white">
        <iframe
          id="previewFrame"
          class="h-full w-full border-0"
          src={hasSite ? `/previews/${project.id}/index.html` : 'about:blank'}
        ></iframe>
        <div
          id="previewEmpty"
          class:list={[
            'absolute inset-0 grid place-items-center bg-[var(--color-panel)] text-sm text-[var(--color-muted)]',
            hasSite && 'hidden',
          ]}
        >
          No preview yet — generate a site to see it here.
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ projectId: project.id }}>
    const chat = document.getElementById('chat')
    const form = document.getElementById('chatForm')
    const briefInput = document.getElementById('brief')
    const frame = document.getElementById('previewFrame')
    const empty = document.getElementById('previewEmpty')
    const publishBtn = document.getElementById('publishBtn')

    function add(role, text) {
      const d = document.createElement('div')
      d.className =
        role === 'user'
          ? 'ml-auto max-w-[85%] rounded-lg bg-primary px-3 py-2 text-white'
          : 'max-w-[85%] rounded-lg bg-[var(--color-panel-2)] px-3 py-2'
      d.textContent = text
      chat.appendChild(d)
      chat.scrollTop = chat.scrollHeight
      return d
    }

    async function render() {
      const r = await fetch('/api/render', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId }),
      })
      const j = await r.json()
      if (j.ok) {
        empty.classList.add('hidden')
        frame.src = j.url + '?t=' + Date.now()
        publishBtn.disabled = false
      }
      return j
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const brief = briefInput.value.trim()
      if (!brief) return
      add('user', brief)
      briefInput.value = ''
      const status = add('ai', 'Generating…')
      try {
        const r = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ projectId, brief }),
        })
        const j = await r.json()
        if (j.ok) {
          status.textContent = 'Generated — rendering preview…'
          const rr = await render()
          status.textContent = rr.ok ? 'Done. Refine it, or Publish.' : 'Generated, but render failed: ' + rr.error
        } else {
          status.textContent = '⚠ ' + (j.error || 'generation failed')
        }
      } catch (err) {
        status.textContent = '⚠ ' + err.message
      }
    })

    document.getElementById('refreshPreview').addEventListener('click', render)
    publishBtn?.addEventListener('click', () =>
      alert('Publish wires to deploy.sh (Nginx + HTTPS) — finishing in the deploy stage.')
    )
  </script>
</Console>
